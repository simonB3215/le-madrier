---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { t, type Lang } from '../i18n';
import { site } from '../config/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const c = tr.contact;
const f = c.form;
const a = site.address;
const action = site.formEndpoint || `mailto:${site.email}`;
const messages = {
  ...f.errors,
  summary: f.summary,
  sending: f.sending,
  submit: f.submit,
  success: f.success,
  mailto: f.mailto,
  error: f.error,
  subject: f.subject,
  labels: {
    arrival: f.arrival,
    departure: f.departure,
    guests: f.guests,
    extra: f.extra,
    name: f.name,
    email: f.email,
    phone: f.phone,
    message: f.message,
  },
};
---

<Base lang={lang} page="contact" title={c.title} description={c.description}>
  <PageHero eyebrow={c.eyebrow} title={c.h1} lead={c.lead} />

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <div class="card p-6 sm:p-9">
        <h2 class="text-3xl">{f.title}</h2>
        <p class="mt-2">{f.required} {f.nights}</p>

        <div
          class="mt-6 rounded-xl border-[3px] border-texte bg-creme p-4"
          role="alert"
          tabindex="-1"
          data-summary
          hidden
        >
          <p class="flex items-center gap-2 font-extrabold"><Icon name="circle-alert" size={20} />{f.summary}</p>
          <ul class="mt-2 list-disc pl-6" data-summary-list></ul>
        </div>

        <form
          class="mt-6 grid gap-5 sm:grid-cols-2"
          action={action}
          method="post"
          enctype={site.formEndpoint ? undefined : 'text/plain'}
          data-form
          data-endpoint={site.formEndpoint}
          data-email={site.email}
          data-min-nights={site.minNights}
          data-messages={JSON.stringify(messages)}
        >
          <div>
            <label class="field-label" for="arrival">{f.arrival} <span aria-hidden="true">*</span></label>
            <input class="input" type="date" id="arrival" name="arrival" required autocomplete="off" aria-describedby="arrival-error" />
            <p class="field-error" id="arrival-error" hidden></p>
          </div>
          <div>
            <label class="field-label" for="departure">{f.departure} <span aria-hidden="true">*</span></label>
            <input class="input" type="date" id="departure" name="departure" required autocomplete="off" aria-describedby="departure-error" />
            <p class="field-error" id="departure-error" hidden></p>
          </div>
          <div>
            <label class="field-label" for="guests">{f.guests} <span aria-hidden="true">*</span></label>
            <input
              class="input"
              type="number"
              id="guests"
              name="guests"
              min="1"
              max="6"
              inputmode="numeric"
              required
              aria-describedby="guests-hint guests-error"
            />
            <p class="field-hint" id="guests-hint">{f.guestsHint}</p>
            <p class="field-error" id="guests-error" hidden></p>
          </div>
          <div>
            <label class="field-label" for="extra">{f.extra} <span class="font-normal">{f.optional}</span></label>
            <select class="input" id="extra" name="extra">
              <option value={f.extraNone}>{f.extraNone}</option>
              <option value={f.extraBed}>{f.extraBed}</option>
              <option value={f.extraCot}>{f.extraCot}</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="name">{f.name} <span aria-hidden="true">*</span></label>
            <input class="input" type="text" id="name" name="name" required autocomplete="name" aria-describedby="name-error" />
            <p class="field-error" id="name-error" hidden></p>
          </div>
          <div>
            <label class="field-label" for="email">{f.email} <span aria-hidden="true">*</span></label>
            <input
              class="input"
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              aria-describedby="email-error"
            />
            <p class="field-error" id="email-error" hidden></p>
          </div>
          <div>
            <label class="field-label" for="phone">{f.phone} <span class="font-normal">{f.optional}</span></label>
            <input class="input" type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="message">{f.message} <span class="font-normal">{f.optional}</span></label>
            <textarea class="input" id="message" name="message" rows="5"></textarea>
          </div>
          {/* Piège à robots : champ invisible, à laisser vide */}
          <div class="hidden" aria-hidden="true">
            <label for="_gotcha">Ne pas remplir</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_subject" value={`${f.subject} – ${site.name}`} />
          <input type="hidden" name="_language" value={lang} />
          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>
              <Icon name="mail" size={20} /><span data-submit-label>{f.submit}</span>
            </button>
            <p class="mt-4 font-extrabold" role="status" aria-live="polite" data-status></p>
          </div>
        </form>
      </div>

      <div>
        <h2 class="text-3xl">{c.details.title}</h2>
        <dl class="mt-6 grid gap-5">
          <div class="flex gap-4">
            <span class="chip"><Icon name="phone" /></span>
            <div>
              <dt class="font-extrabold">{c.details.phone}</dt>
              <dd><a class="link inline-flex min-h-11 items-center" href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="chip"><Icon name="mail" /></span>
            <div>
              <dt class="font-extrabold">{c.details.email}</dt>
              <dd><a class="link inline-flex min-h-11 items-center" href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="chip"><Icon name="map-pin" /></span>
            <div>
              <dt class="font-extrabold">{c.details.address}</dt>
              <dd>
                <address class="not-italic">
                  {site.name}<br />
                  {a.street}<br />
                  CH-{a.postalCode} {a.locality}
                </address>
                <a class="link mt-1 inline-flex min-h-11 items-center gap-1.5" href={site.mapLink} target="_blank" rel="noopener">
                  {c.details.route}<Icon name="external-link" size={16} /><span class="sr-only">{tr.common.newTab}</span>
                </a>
              </dd>
            </div>
          </div>
        </dl>

        <h2 class="mt-8 text-2xl">{c.details.map}</h2>
        <div class="photo mt-4" style="aspect-ratio: 4 / 3">
          <iframe
            src={site.mapEmbedUrl}
            title={c.details.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            class="h-full w-full border-0"></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const msg = JSON.parse(form.dataset.messages!);
    const minNights = Number(form.dataset.minNights) || 1;
    const summary = document.querySelector<HTMLElement>('[data-summary]')!;
    const summaryList = summary.querySelector('[data-summary-list]')!;
    const status = form.querySelector('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const buttonLabel = form.querySelector('[data-submit-label]')!;
    const field = (id: string) => form.elements.namedItem(id) as HTMLInputElement;
    form.noValidate = true; // les messages ci-dessous remplacent ceux du navigateur

    const today = new Date().toISOString().slice(0, 10);
    field('arrival').min = today;
    field('departure').min = today;

    const check = (): Record<string, string> => {
      const errors: Record<string, string> = {};
      const arrival = field('arrival').value;
      const departure = field('departure').value;
      if (!arrival) errors.arrival = msg.arrival;
      if (!departure) errors.departure = msg.departure;
      if (arrival && departure) {
        const nights = (Date.parse(departure) - Date.parse(arrival)) / 86400000;
        if (nights <= 0) errors.departure = msg.order;
        else if (nights < minNights) errors.departure = msg.minNights;
      }
      if (!(Number(field('guests').value) >= 1)) errors.guests = msg.guests;
      if (!field('name').value.trim()) errors.name = msg.name;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field('email').value.trim())) errors.email = msg.email;
      return errors;
    };

    const paint = (errors: Record<string, string>) => {
      for (const id of ['arrival', 'departure', 'guests', 'name', 'email']) {
        const el = field(id);
        const box = document.getElementById(`${id}-error`)!;
        if (errors[id]) {
          el.setAttribute('aria-invalid', 'true');
          box.textContent = errors[id];
          box.hidden = false;
        } else {
          el.removeAttribute('aria-invalid');
          box.textContent = '';
          box.hidden = true;
        }
      }
    };

    // Une fois un champ signalé, l'erreur disparaît dès qu'il est corrigé
    form.addEventListener('focusout', (e) => {
      const el = e.target as HTMLElement;
      if (el.getAttribute?.('aria-invalid') === 'true' || form.dataset.touched) paint(check());
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.dataset.touched = '1';
      status.textContent = '';
      const errors = check();
      paint(errors);
      const ids = Object.keys(errors);
      if (ids.length) {
        summaryList.replaceChildren(
          ...ids.map((id) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#${id}`;
            a.className = 'link';
            a.textContent = errors[id];
            a.addEventListener('click', (ev) => {
              ev.preventDefault();
              field(id).focus();
            });
            li.append(a);
            return li;
          })
        );
        summary.hidden = false;
        summary.focus();
        return;
      }
      summary.hidden = true;

      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      // Pas d'adresse d'envoi configurée : on ouvre la messagerie du visiteur
      if (!form.dataset.endpoint) {
        const lines = Object.entries(msg.labels as Record<string, string>)
          .map(([key, label]) => `${label} : ${data.get(key) || '–'}`)
          .join('\n');
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(msg.subject)}&body=${encodeURIComponent(lines)}`;
        status.textContent = msg.mailto;
        return;
      }

      button.disabled = true;
      buttonLabel.textContent = msg.sending;
      try {
        const res = await fetch(form.dataset.endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        delete form.dataset.touched;
        status.textContent = msg.success;
      } catch {
        status.textContent = msg.error;
      } finally {
        button.disabled = false;
        buttonLabel.textContent = msg.submit;
      }
    });
  }
</script>
