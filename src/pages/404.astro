---
import Base from '../layouts/Base.astro';
import { t, routes } from '../i18n';
const fr = t('fr').notFound;
const en = t('en').notFound;
---

<Base lang="fr" page={null} title={fr.title}>
  <section class="section">
    <div class="wrap max-w-2xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">{fr.h1}</h1>
      <p class="lead mt-5">{fr.text}</p>
      <a href={routes.home.fr} class="btn btn-primary mt-7">{fr.back}</a>
      <div lang="en" class="mt-12 border-t-2 border-noyer/20 pt-8">
        <h2 class="text-2xl">{en.h1}</h2>
        <p class="mt-3">{en.text}</p>
        <a href={routes.home.en} class="btn btn-secondary mt-5">{en.back}</a>
      </div>
    </div>
  </section>
</Base>
