---
import Icon from './Icon.astro';
import { t, routes, navOrder, type Lang } from '../i18n';
import { site } from '../config/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const a = site.address;
const linkCls =
  'inline-flex min-h-11 items-center gap-2 font-bold text-miel underline decoration-miel/50 underline-offset-4 transition-colors duration-200 hover:text-creme hover:decoration-creme';
const external = [
  { name: tr.region.links.tourism.name, href: 'https://www.alpesvaudoises.ch' },
  { name: tr.region.links.glacier.name, href: 'https://www.glacier3000.ch' },
  { name: tr.footer.facebook, href: site.facebook },
];
---

<footer class="on-dark bg-texte pb-28 text-creme lg:pb-0">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-serif text-3xl font-semibold text-creme">Le Madrier</p>
      <p class="mt-4 max-w-xs">{tr.footer.about}</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-extrabold tracking-[0.12em] text-creme uppercase">{tr.footer.contact}</h2>
      <address class="mt-3 not-italic">
        <p>
          {site.name}<br />
          {a.street}<br />
          CH-{a.postalCode} {a.locality}
        </p>
        <p class="mt-2 flex flex-col">
          <a href={`tel:${site.phoneHref}`} class={linkCls}><Icon name="phone" size={18} />{site.phone}</a>
          <a href={`mailto:${site.email}`} class={linkCls}><Icon name="mail" size={18} />{site.email}</a>
        </p>
      </address>
    </div>

    <nav aria-label={tr.footer.pages}>
      <h2 class="font-sans text-sm font-extrabold tracking-[0.12em] text-creme uppercase">{tr.footer.pages}</h2>
      <ul class="mt-3">
        {
          navOrder.map((k) => (
            <li>
              <a href={routes[k][lang]} class={linkCls}>
                {tr.nav[k]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-extrabold tracking-[0.12em] text-creme uppercase">{tr.footer.links}</h2>
      <ul class="mt-3">
        {
          external.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class={linkCls}>
                {l.name}
                <Icon name="external-link" size={16} />
                <span class="sr-only">{tr.common.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-creme/20">
    <p class="wrap py-5 text-sm">© {new Date().getFullYear()} {tr.footer.rights} · {a.locality}, {lang === 'fr' ? 'Suisse' : 'Switzerland'}</p>
  </div>
</footer>
