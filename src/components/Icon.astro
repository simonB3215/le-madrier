---
// Icônes Lucide (une seule famille, trait de 1.75 px), intégrées au HTML.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = '' } = Astro.props;
const files = import.meta.glob(
  '/node_modules/lucide-static/icons/{users,bed-double,square-parking,wifi,calendar-days,phone,mail,map-pin,cigarette-off,baby,paw-print,washing-machine,tv,tree-pine,sun,snowflake,bath,utensils,sofa,check,arrow-right,x,chevron-left,chevron-right,menu,external-link,mountain-snow,door-open,circle-alert,cable-car,banknote,clock,moon,bed-single,star}.svg',
  { query: '?raw', import: 'default', eager: true }
) as Record<string, string>;
const raw = files[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Icône inconnue : ${name}`);
const inner = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/<svg[\s\S]*?>/, '')
  .replace('</svg>', '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={`shrink-0 ${cls}`}
  set:html={inner}
/>
