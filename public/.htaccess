# Hébergement Apache / Plesk (hébergeur actuel de lemadrier.ch)
RewriteEngine On

# 1. Tout le site en HTTPS, sur www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.lemadrier.ch%{REQUEST_URI} [R=301,L]

# 2. Redirections 301 depuis les anciennes adresses
RewriteRule ^le-chalet/?$ /appartement/ [R=301,L]
RewriteRule ^info/les-photos-dete/?$ /photos/ [R=301,L]
RewriteRule ^info/les-photos-dhiver/?$ /photos/ [R=301,L]
RewriteRule ^info/?$ /tarifs-reservation/ [R=301,L]

<IfModule mod_headers.c>
  # Le navigateur retient que le site n'existe qu'en HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Fichiers générés avec une empreinte dans leur nom : cache long
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
